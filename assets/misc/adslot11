    <script>
        function showMore(last_id, main_id, sub_id) {

            var ajaxdata = new FormData();
            ajaxdata.append('last_id', last_id);
            ajaxdata.append('main_id', main_id);
            ajaxdata.append("sub_id", sub_id);

            $.ajax({
                type: "POST",
                contentType: false,
                processData: false,
                url: "/show_more",
                data: ajaxdata,
                success: function (data) {

                    let last_ids='';
                    if (data.status == "true") {
                        var ads = data.data;
                        let i=0;
                        last_ids=data.last_ids;
                        for (i ; i < ads.length; i++) {

                            last_ids += ads[i].id + "-";
                            var baseUrl = "https://accszone.com";
                            let imageUrl = ads[i].listing_logo ? baseUrl + '/' + ads[i].listing_logo : baseUrl + '/' + ads[i]['main_category'].image_path;

                            $("#table_" + main_id + "_" + sub_id + " tr:last").after( `
                                    <tr class="bg-white">
                                        <td><img src="${imageUrl}" alt="${ads[i]['main_category'] && ads[i]['main_category'].title ? ads[i]['main_category'].title + ' accounts for sale' : 'AccsZone accounts for sale'}" width="40" height="40" loading="lazy" style="border-radius: 8px;">
                                        </td>
                                        <td class="fs-6"><a href="ad_details/${ads[i].slug}"
                                                            style="cursor: pointer;font-size: 18px "
                                                            class="text-dark  text-decoration-none">${ads[i].title}</a>
                                        </td>
                                        <td class="fs-6">${ads[i].available_stock <= 0 ? '<span class="badge bg-secondary">Sold Out</span>' : ads[i].available_stock + ' pcs.'}
                                            <br><small class="text-muted">Sold ${ads[i].sold ?? 0} pieces</small>
                                        </td>
                                        <td class="text-secondary fs-6">Price per pc</td>
                                        <td class="fs-6">
                                            <span class="mobile-only">price/pc</span>
                                            from $${ads[i].total_price}
                                        </td>
                                        <td class="fs-6"><a href="ad_details/${ads[i].slug}"
                                                            class="btn btn-primary btn-sm tableBtn text-decoration-none"><i
                                                        class="fa fa-shopping-cart"></i> Buy</a></td>
                                    </tr>`

                            );
                        }

                        if (i != 0) {
                            i=i-1;
                            $("#btn"+ main_id + "_" + sub_id).html('');
                            last_ids = "'" + last_ids + "'";
                            // Create a new button element with updated values and append it to the container
                            var newButton = `
