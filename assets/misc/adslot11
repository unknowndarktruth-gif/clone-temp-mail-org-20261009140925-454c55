<script>
    // Header Scroll Effect
    window.addEventListener('scroll', function() {
        const header = document.getElementById('mainHeader');
        if (window.scrollY > 50) {
            header.classList.add('scrolled');
        } else {
            header.classList.remove('scrolled');
        }
    });

    // Categories Bar Scroll Logic
    document.addEventListener('DOMContentLoaded', function() {
        const navScroll = document.getElementById('navScroll');
        const btnLeft = document.getElementById('navScrollLeft');
        const btnRight = document.getElementById('navScrollRight');

        if (!navScroll || !btnLeft || !btnRight) return;

        const wrapper = navScroll.closest('.nav-scroll-wrapper');

        const updateButtons = () => {
            const scrollLeft = navScroll.scrollLeft;
            const scrollWidth = navScroll.scrollWidth;
            const clientWidth = navScroll.clientWidth;

            const isLeftVisible = scrollLeft > 10;
            const isRightVisible = scrollLeft < (scrollWidth - clientWidth - 10);

            btnLeft.classList.toggle('visible', isLeftVisible);
            btnRight.classList.toggle('visible', isRightVisible);

            if (wrapper) {
                wrapper.classList.toggle('fade-left', isLeftVisible);
                wrapper.classList.toggle('fade-right', isRightVisible);
            }
        };

        // Advance by a full page (the next screenful of items) instead of one item.
        // A small overlap keeps one item of context between pages for smoother orientation.
        const MAX_ITEMS_PER_STEP = 5;
        const getPageStep = () => {
            const clientWidth = navScroll.clientWidth;
            const firstItem = navScroll.querySelector('.nav-item-premium');
            if (firstItem) {
                const itemWidth = firstItem.getBoundingClientRect().width;
                // How many fit in view, but never advance more than MAX_ITEMS_PER_STEP.
                const fit = Math.max(1, Math.floor(clientWidth / itemWidth));
                const perPage = Math.min(fit, MAX_ITEMS_PER_STEP);
                return itemWidth * perPage;
            }
            return Math.min(clientWidth, 250 * MAX_ITEMS_PER_STEP);
        };

        btnLeft.addEventListener('click', () => {
            navScroll.scrollBy({ left: -getPageStep(), behavior: 'smooth' });
        });

        btnRight.addEventListener('click', () => {
            navScroll.scrollBy({ left: getPageStep(), behavior: 'smooth' });
        });

        navScroll.addEventListener('scroll', updateButtons);
        window.addEventListener('resize', updateButtons);

        // Initial check after a short delay to ensure everything is rendered
        setTimeout(updateButtons, 500);

        // Category Toggle Logic
        const catTrigger = document.querySelector('.btn-cat-trigger');
        const catDropdown = document.querySelector('.premium-cat-dropdown');

        if (catTrigger && catDropdown) {
            catTrigger.addEventListener('click', function(e) {
                e.stopPropagation();
                catDropdown.classList.toggle('active');
            });

            // Close when clicking outside
            document.addEventListener('click', function(e) {
                if (!catDropdown.contains(e.target)) {
                    catDropdown.classList.remove('active');
                }
            });

            // Close on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    catDropdown.classList.remove('active');
                }
            });
        }
    });

