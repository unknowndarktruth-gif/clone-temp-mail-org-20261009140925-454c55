        .scroll-to-top {
            position: fixed;
            bottom: 30px;
            left: 30px;
            width: 40px;
            height: 40px;
            background: #D8842C;
            color: #fff;
            border: none;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 9999;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px rgba(216, 132, 44, 0.3);
        }
        .scroll-to-top.show {
            opacity: 1;
            visibility: visible;
        }
        .scroll-to-top:hover {
            background: #B46E25;
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(216, 132, 44, 0.4);
            color: #fff;
        }
        .site-announcement-bar {
            --announcement-bg: #f6f2ec;
            --announcement-accent: #d8842c;
            --announcement-text: #2f2f2f;
            overflow: hidden;
            background: linear-gradient(180deg, #faf7f2 0%, var(--announcement-bg) 100%);
            border-top: 1px solid rgba(216, 132, 44, 0.35);
            border-bottom: 1px solid rgba(216, 132, 44, 0.2);
            position: relative;
            z-index: 10;
        }
        .site-announcement-bar::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: var(--announcement-accent);
        }
        .site-announcement-track {
            display: flex;
            align-items: center;
            min-height: 38px;
            width: max-content;
            gap: 16.1rem;
            animation: siteAnnouncementScroll var(--announcement-duration, 22s) linear infinite;
            will-change: transform;
            backface-visibility: hidden;
            transform: translateZ(0);
        }
        .site-announcement-bar:hover .site-announcement-track {
            animation-play-state: paused;
        }
        .site-announcement-item {
            display: inline-flex;
            align-items: center;
            white-space: nowrap;
            color: var(--announcement-text);
            font-weight: 600;
            font-size: 15px;
            letter-spacing: 0.15px;
            padding: 7px 2.2rem;
        }
        .site-announcement-segment {
            display: inline-flex;
            align-items: center;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .site-announcement-label {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--announcement-accent);
            font-weight: 700;
            margin-right: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-size: 12px;
        }
        .site-announcement-dot {
            color: rgba(216, 132, 44, 0.7);
            margin: 0 0.8rem;
            font-size: 10px;
        }
        @keyframes siteAnnouncementScroll {
            0% {
                transform: translate3d(0, 0, 0);
            }
            100% {
                transform: translate3d(calc(-1 * var(--announcement-loop-distance, 50%)), 0, 0);
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .site-announcement-track {
                animation: none;
                width: 100%;
                justify-content: center;
            }
            .site-announcement-segment + .site-announcement-segment {
                display: none;
            }
        }
        @media (max-width: 768px) {
            .scroll-to-top {
                bottom: 20px;
                left: 20px;
                width: 35px;
                height: 35px;
                border-radius: 8px;
            }
        }
