    // Keep announcement ticker loop smooth on large screens.
    (function () {
        const bar = document.querySelector('.site-announcement-bar');
        if (!bar) return;

        const track = bar.querySelector('.site-announcement-track');
        const baseSegment = bar.querySelector('.site-announcement-segment');
        if (!track || !baseSegment) return;

        const updateTickerMetrics = () => {
            const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (prefersReduced) return;

            // Remove previously generated clones before recalculation.
            track.querySelectorAll('[data-announcement-clone="1"]').forEach((node) => node.remove());

            const computed = window.getComputedStyle(track);
            const gap = parseFloat(computed.gap || '0') || 0;
            const baseSegmentWidth = Math.max(baseSegment.getBoundingClientRect().width, 1);

            // Ensure enough repeated segments so next message is already entering.
            while (track.scrollWidth < (bar.clientWidth + baseSegmentWidth)) {
                const clone = baseSegment.cloneNode(true);
                clone.setAttribute('aria-hidden', 'true');
                clone.setAttribute('data-announcement-clone', '1');
                track.appendChild(clone);
            }

            const loopDistance = Math.max(baseSegmentWidth + gap, 1);

            // Professional readability speed in px/s.
            // Slightly slower baseline for smoother reading on all viewports.
            const pxPerSecond = window.innerWidth >= 1200 ? 95 : (window.innerWidth >= 768 ? 85 : 75);
            const duration = Math.max(loopDistance / pxPerSecond, 10);

            track.style.setProperty('--announcement-loop-distance', `${loopDistance}px`);
            track.style.setProperty('--announcement-duration', `${duration}s`);
        };

        let resizeTimer = null;
        updateTickerMetrics();
        window.addEventListener('resize', () => {
            if (resizeTimer) clearTimeout(resizeTimer);
            resizeTimer = setTimeout(updateTickerMetrics, 120);
        });
    })();
</script>


